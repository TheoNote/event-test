{% extends 'base.html.twig' %}

{% block title %} {{ parent() }}Inscription{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2>Rejoignez-nous</h2>

        {{ form_start(form, {'attr': {'class': 'form-signup'}}) }}

        {# Affichage des erreurs globales #}
        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_label(form.username, 'Nom d\'utilisateur') }}
            {{ form_widget(form.username, {'attr': {'class': 'form-control', 'placeholder': 'Nom d\'utilisateur'}}) }}
            {{ form_errors(form.username) }}
        </div>

        {# Champ Email #}
        <div class="form-group">
            {{ form_label(form.email, 'Adresse e-mail') }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@mail.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        {# Champ Mot de passe #}
        <div class="form-group">
            <div class="form-group">
                {{ form_label(form.password.first, 'Mot de passe')}}
                {{ form_widget(form.password.first, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                {{ form_errors(form.password.first) }}
            </div>

            <div class="form-group">
                {{ form_label(form.password.second, 'Valider le mot de pass') }}
                {{ form_widget(form.password.second, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                {{ form_errors(form.password.second) }}
            </div>
        </div>


        <button type="submit" class="btn btn-primary">Créer mon compte</button>

        {{ form_end(form) }}
    </div>
{% endblock %}
