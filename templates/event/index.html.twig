{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} | Nos Événements
{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">📅 Nos événements</h1>

        <a href="{{ path('create-event') }}">➕ Créer un événement
        </a>
    </div>

    <div class="row g-4">
        {% for event in events %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">

                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3 class="card-title h5 mb-0">
                            {{ event.title }}
                        </h3>

                        {% if event.status is defined %}
                            <span class="badge bg-primary">
                                    {{ event.status.name }}
                                </span>
                        {% endif %}
                    </div>

                    <p class="text-muted small mb-3">
                        🕒 {{ event.startAt|date('d/m/Y à H:i') }}
                    </p>

                    {% if event.description %}
                        <p class="card-text text-secondary">
                            {{ event.description|slice(0, 120) }}
                            {% if event.description|length > 120 %}...{% endif %}
                        </p>
                    {% endif %}

                    <div class="mt-auto">
                        <a href = "{{ path('show-event', {slug: event.slug}) }}"
                        class="btn btn-outline-primary w-100">
                        Voir les détails
                        </a>
                    </div>

                </div>

            </div>
        </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">
                    Aucun événement publié pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
